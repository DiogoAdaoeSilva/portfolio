---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';
import CloudinaryVideo from '../components/CloudinaryVideo.astro';
import FinanceViz from '../components/visualizations/FinanceViz.astro';
import BookmarksViz from '../components/visualizations/BookmarksViz.astro';
import QaViz from '../components/visualizations/QaViz.astro';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);

// Asymmetric size schedule, repeats if there are more projects.
// Matches the design: feature → large → medium → small → small → …
const SIZE_SCHEDULE = ['feature', 'large', 'medium', 'small', 'small'] as const;
type CardSize = typeof SIZE_SCHEDULE[number];

const projects = sorted.map((p, i) => ({
  ...p,
  size: SIZE_SCHEDULE[i] ?? 'small',
}));

const allTags = [...new Set(sorted.flatMap(p => p.data.tags ?? []))].sort();
const categories = ['All', ...allTags];
const tagCounts: Record<string, number> = { All: sorted.length };
allTags.forEach(t => {
  tagCounts[t] = sorted.filter(p => (p.data.tags ?? []).includes(t)).length;
});

---

<BaseLayout title="VIBE — Selected Work">
  <main id="work" class="pt-28 pb-0">

    <!-- Page header -->
    <section class="px-6 md:px-14 pt-12 md:pt-20 pb-12 border-b border-outline-variant/30">
      <div class="max-w-[1400px] mx-auto">
        <div class="eyebrow flex items-center gap-3 mb-8 text-[11px] tracking-[0.18em] uppercase text-on-surface-variant font-medium">
          <span class="text-primary">§ 01</span>
          <span class="inline-block w-8 h-px bg-current opacity-50"></span>
          <span>Diogo Adão e Silva · Portfolio · 2026</span>
        </div>
        <h1 class="font-bold tracking-tighter leading-[0.9] text-on-surface flex items-baseline flex-wrap gap-x-[0.2em]"
            style="font-size: clamp(3.5rem, 10vw, 7rem); margin-left: -0.06em;">
          <span>Creating</span>
          <span class="text-primary">Waves</span>
        </h1>
        <div class="mt-9">
          <p class="m-0 text-lg leading-snug text-on-surface-variant max-w-[56ch]" style="text-wrap: pretty;">
          Collection of product experiments inspired by challenges at work and personal interests.
          </p>
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    {categories.length > 2 && (
      <section class="px-6 md:px-14 py-5 border-b border-outline-variant/30 sticky top-[72px] z-10 backdrop-blur" style="background: color-mix(in oklab, #f9f9f7 92%, transparent);">
        <div class="max-w-[1400px] mx-auto flex items-center justify-between gap-6 flex-wrap">
          <div id="chips" class="flex flex-wrap gap-2">
            {categories.map(cat => (
              <button
                type="button"
                class="chip text-[11px] font-medium uppercase tracking-[0.08em] px-3 py-1.5 rounded-full border border-outline-variant/60 text-on-surface-variant hover:border-on-surface-variant hover:text-on-surface transition inline-flex items-center gap-2"
                data-tag={cat}
                aria-pressed={cat === 'All' ? 'true' : 'false'}
              >
                {cat}
                <span class="text-[9px] opacity-55">{String(tagCounts[cat] || 0).padStart(2, '0')}</span>
              </button>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Grid -->
    <section class="px-6 md:px-14 pt-6 pb-16">
      <div id="grid" class="max-w-[1400px] mx-auto grid grid-cols-12 gap-6">
        {projects.map((project, i) => {
          const { data, id, size } = project;
          const colSpan =
            size === 'feature' ? 'col-span-12'
            : size === 'large' ? 'col-span-12 md:col-span-8'
            : size === 'medium' ? 'col-span-12 md:col-span-6'
            : 'col-span-12 sm:col-span-6 md:col-span-4';
          const aspect =
            size === 'feature' ? 'aspect-[24/10]'
            : size === 'large' ? 'aspect-[16/10]'
            : size === 'medium' ? 'aspect-[4/3]'
            : 'aspect-[5/4]';
          const titleSize =
            size === 'feature' ? 'text-4xl md:text-6xl'
            : size === 'large' ? 'text-3xl md:text-5xl'
            : size === 'medium' ? 'text-2xl md:text-3xl'
            : 'text-xl md:text-2xl';
          const bodyPad = (size === 'feature' || size === 'large') ? 'p-7 md:p-9' : 'p-5 md:p-6';
          const num = String(i + 1).padStart(2, '0');
          return (
            <a
              href={`/projects/${id}`}
              class:list={[colSpan, "card group relative flex flex-col bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden transition hover:-translate-y-1 hover:border-on-surface/40 hover:shadow-[0_24px_60px_-30px_rgba(45,52,50,0.3)]"]}
              data-tags={(data.tags ?? []).join(',')}
            >
              <div class:list={["media relative overflow-hidden bg-surface-container border-b border-outline-variant/30", aspect]}>
                <div class="absolute inset-0">
                  {id === 'personal-finance-reports' ? (
                    <FinanceViz />
                  ) : id === 'x-bookmarks' ? (
                    <BookmarksViz />
                  ) : id === 'ecommerce-qa-automation' ? (
                    <QaViz />
                  ) : data.coverVideo && data.coverVideoAutoplay ? (
                    <CloudinaryVideo
                      publicId={data.coverVideo}
                      autoplay
                      loop
                      muted
                      class="w-full h-full"
                    />
                  ) : (
                    <CloudinaryImage
                      publicId={data.coverImage}
                      alt={data.title}
                      width={size === 'feature' ? 1800 : size === 'large' ? 1400 : 900}
                      class="w-full h-full object-cover transition duration-700 group-hover:scale-[1.02]"
                    />
                  )}
                </div>
                <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, transparent 60%, rgba(249,249,247,0.4));"></div>
                <span class="absolute top-4 left-4 text-[10px] font-medium uppercase tracking-[0.1em] text-on-surface-variant px-2 py-1 rounded border border-outline-variant/40 backdrop-blur-sm" style="background: color-mix(in oklab, #ffffff 80%, transparent);">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary align-middle mr-1.5"></span>
                  {data.category} · {data.year}
                </span>
                <span class="absolute top-4 right-4 text-[10px] font-medium tracking-[0.12em] text-on-surface-variant">№ {num}</span>
              </div>
              <div class:list={[bodyPad, "flex flex-col gap-3 flex-1"]}>
                <h2 class:list={[titleSize, "font-bold leading-[1.04] tracking-tight m-0 flex items-baseline gap-3"]} style="text-wrap: balance;">
                  {data.title}
                  <span class="arrow text-sm text-on-surface-variant self-center transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-primary">↗</span>
                </h2>
                <p class="desc text-on-surface-variant m-0 text-[15px] leading-[1.5] max-w-[52ch]" style="text-wrap: pretty;">
                  {data.tagline}
                </p>
                <div class="meta-row mt-auto flex items-center justify-between pt-3.5 border-t border-dashed border-outline-variant/40 text-[10px] font-medium uppercase tracking-[0.1em] text-on-surface-variant gap-3 flex-wrap">
                  <div class="flex flex-wrap gap-1.5">
                    {(data.tags ?? []).map(t => (
                      <span class="px-1.5 py-0.5 border border-outline-variant/40 rounded-sm text-on-surface-variant">{t}</span>
                    ))}
                  </div>
                  <div class="flex gap-3.5 items-center whitespace-nowrap">
                    <span>Live</span>
                    <span>{data.year}</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#chips .chip');
  const cards = document.querySelectorAll<HTMLElement>('#grid [data-tags]');

  function setActive(active: HTMLButtonElement) {
    chips.forEach(c => {
      const isActive = c === active;
      c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      c.classList.toggle('bg-on-surface', isActive);
      c.classList.toggle('text-surface', isActive);
      c.classList.toggle('border-on-surface', isActive);
    });
  }

  // initialize "All" as visually active
  const initial = document.querySelector<HTMLButtonElement>('#chips .chip[data-tag="All"]');
  if (initial) setActive(initial);

  chips.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? 'All';
      setActive(btn);
      cards.forEach(card => {
        const cardTags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const visible = tag === 'All' || cardTags.includes(tag);
        card.style.display = visible ? '' : 'none';
      });
    });
  });
</script>

<style>
  .card {
    transition: transform .45s cubic-bezier(.2,.7,.2,1), border-color .25s, box-shadow .35s;
  }
</style>
