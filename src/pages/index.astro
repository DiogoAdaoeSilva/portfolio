---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';
import CloudinaryVideo from '../components/CloudinaryVideo.astro';
import FinanceViz from '../components/visualizations/FinanceViz.astro';
import BookmarksViz from '../components/visualizations/BookmarksViz.astro';
import QaViz from '../components/visualizations/QaViz.astro';
import SavingsViz from '../components/visualizations/SavingsViz.astro';
import VoiceViz from '../components/visualizations/VoiceViz.astro';

const allProjects = await getCollection('projects');
const sorted = allProjects.sort((a, b) => a.data.order - b.data.order);

// Row-based size schedule so every row fills all 12 columns:
// two full-width features, then pairs of mediums and triples of smalls.
// A short tail is resized so the last row never leaves a gap.
type CardSize = 'feature' | 'large' | 'medium' | 'small';

function buildSizes(count: number): CardSize[] {
  const sizes: CardSize[] = [];
  const ROWS: CardSize[][] = [['medium', 'medium'], ['small', 'small', 'small']];
  sizes.push(...(['feature', 'feature'] as CardSize[]).slice(0, count));
  let r = 0;
  while (sizes.length < count) {
    const left = count - sizes.length;
    const row = ROWS[r++ % ROWS.length];
    if (left >= row.length) sizes.push(...row);
    else if (left === 2) sizes.push('medium', 'medium');
    else sizes.push('feature');
  }
  return sizes;
}

const sizes = buildSizes(sorted.length);
const projects = sorted.map((p, i) => ({ ...p, size: sizes[i] }));
const firstImageProjectId = projects.find((project) => (
  Boolean(project.data.coverImage) && !project.data.coverVideoAutoplay
))?.id;

const allTags = [...new Set(sorted.flatMap(p => p.data.tags ?? []))].sort();
const categories = ['All', ...allTags];
const tagCounts: Record<string, number> = { All: sorted.length };
allTags.forEach(t => {
  tagCounts[t] = sorted.filter(p => (p.data.tags ?? []).includes(t)).length;
});

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diogo Adão e Silva',
  url: new URL('/', Astro.site).href,
  jobTitle: 'Product Manager',
  email: 'mailto:diogofcruz@gmail.com',
  sameAs: [
    'https://github.com/DiogoAdaoeSilva',
    'https://www.linkedin.com/in/diogoadaoesilva/',
  ],
};

---

<BaseLayout
  title="Selected Work"
  description="Diogo Adão e Silva is a Product Manager building AI-native product experiments in automation, operational systems, and human + AI collaboration."
  structuredData={personSchema}
>
  <main id="work" class="pt-28 pb-0">

    <!-- Page header -->
    <section class="px-6 md:px-14 pt-4 md:pt-6 pb-12 border-b border-outline-variant/30">
      <div class="max-w-[1400px] mx-auto">
        <h1 class="font-bold tracking-tighter leading-[0.9] text-on-surface flex items-baseline flex-wrap gap-x-[0.2em]"
            style="font-size: clamp(3.5rem, 10vw, 7rem); margin-left: -0.06em;">
          <span>Creating</span>
          <span class="text-primary">Waves</span>
        </h1>
        <div class="mt-9">
          <p class="m-0 text-lg leading-snug text-on-surface-variant max-w-[56ch]" style="text-wrap: pretty;">
          A collection of product experiments inspired by challenges at work and personal interests.
          </p>
        </div>
        <div class="eyebrow mt-10 text-[11px] tracking-[0.18em] uppercase text-on-surface-variant font-medium">
          Diogo Adão e Silva · Product Manager
        </div>
      </div>
    </section>

    <!-- Filter bar -->
    {categories.length > 2 && (
      <section class="px-6 md:px-14 py-2.5 md:py-5 border-b border-outline-variant/30 sticky top-[72px] z-10 backdrop-blur" style="background: color-mix(in oklab, #f9f9f7 92%, transparent);">
        <div class="max-w-[1400px] mx-auto">
          <!-- Mobile: collapsed to a single toggle showing the active filter -->
          <button
            id="filter-toggle"
            type="button"
            class="md:hidden text-[11px] font-medium uppercase tracking-[0.08em] h-8 px-3 rounded-full border border-outline-variant/60 text-on-surface-variant transition inline-flex items-center gap-2"
            aria-expanded="false"
            aria-controls="chips"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M3 6h18M7 12h10M10 18h4" />
            </svg>
            <span id="filter-label">All</span>
            <span id="filter-count" class="text-[9px] opacity-55">{String(tagCounts.All).padStart(2, '0')}</span>
          </button>
          <div id="chips" class="hidden md:flex flex-wrap gap-2 pt-3 pb-1 md:p-0">
            {categories.map(cat => (
              <button
                type="button"
                class="chip text-[11px] font-medium uppercase tracking-[0.08em] px-3 py-1.5 rounded-full border border-outline-variant/60 text-on-surface-variant hover:border-on-surface-variant hover:text-on-surface transition inline-flex items-center gap-2"
                data-tag={cat}
                aria-pressed={cat === 'All' ? 'true' : 'false'}
              >
                {cat}
                <span class="text-[9px] opacity-55">{String(tagCounts[cat] || 0).padStart(2, '0')}</span>
              </button>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Grid -->
    <section class="px-6 md:px-14 pt-6 pb-16">
      <div id="grid" class="max-w-[1400px] mx-auto grid grid-cols-12 gap-6">
        {projects.map((project, i) => {
          const { data, id, size } = project;
          const colSpan =
            size === 'feature' ? 'col-span-12'
            : size === 'large' ? 'col-span-12 md:col-span-8'
            : size === 'medium' ? 'col-span-12 md:col-span-6'
            : 'col-span-12 sm:col-span-6 md:col-span-4';
          const aspect =
            size === 'feature' ? 'aspect-[4/3] sm:aspect-[16/9] md:aspect-[24/10]'
            : size === 'large' ? 'aspect-[16/10]'
            : size === 'medium' ? 'aspect-[4/3]'
            : 'aspect-[5/4]';
          const titleSize =
            size === 'feature' ? 'text-4xl md:text-6xl'
            : size === 'large' ? 'text-3xl md:text-5xl'
            : size === 'medium' ? 'text-2xl md:text-3xl'
            : 'text-xl md:text-2xl';
          const bodyPad = (size === 'feature' || size === 'large') ? 'p-7 md:p-9' : 'p-5 md:p-6';
          const num = String(i + 1).padStart(2, '0');
          return (
            <a
              href={`/projects/${id}`}
              class:list={[colSpan, "card group relative flex flex-col bg-surface-container-lowest border border-outline-variant/30 rounded-lg overflow-hidden transition hover:-translate-y-1 hover:border-on-surface/40 hover:shadow-[0_24px_60px_-30px_rgba(45,52,50,0.3)]"]}
              data-tags={(data.tags ?? []).join(',')}
            >
              <div class:list={["media relative overflow-hidden bg-surface-container border-b border-outline-variant/30", aspect]}>
                <div class="absolute inset-0">
                  {id === 'personal-finance-reports' ? (
                    <FinanceViz />
                  ) : id === 'x-bookmarks' ? (
                    <BookmarksViz />
                  ) : id === 'ecommerce-qa-automation' ? (
                    <QaViz />
                  ) : id === 'savings-atlas' ? (
                    <SavingsViz />
                  ) : id === 'ask-diogo' ? (
                    <VoiceViz />
                  ) : data.coverVideo && data.coverVideoAutoplay ? (
                    <CloudinaryVideo
                      publicId={data.coverVideo}
                      autoplay
                      loop
                      muted
                      class="w-full h-full"
                    />
                  ) : (
                    <CloudinaryImage
                      publicId={data.coverImage}
                      alt={data.title}
                      width={size === 'feature' ? 1800 : size === 'large' ? 1400 : 900}
                      loading={id === firstImageProjectId ? 'eager' : 'lazy'}
                      fetchpriority={id === firstImageProjectId ? 'high' : 'auto'}
                      class="w-full h-full object-cover transition duration-700 group-hover:scale-[1.02]"
                    />
                  )}
                </div>
                <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, transparent 60%, rgba(249,249,247,0.4));"></div>
                <span class="absolute top-4 left-4 text-[10px] font-medium uppercase tracking-[0.1em] text-on-surface-variant px-2 py-1 rounded border border-outline-variant/40 backdrop-blur-sm" style="background: color-mix(in oklab, #ffffff 80%, transparent);">
                  <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary align-middle mr-1.5"></span>
                  {data.category} · {data.year}
                </span>
                <span class="absolute top-4 right-4 text-[10px] font-medium tracking-[0.12em] text-on-surface-variant">№ {num}</span>
              </div>
              <div class:list={[bodyPad, "flex flex-col gap-3 flex-1"]}>
                <h2 class:list={[titleSize, "font-bold leading-[1.04] tracking-tight m-0 flex items-baseline gap-3"]} style="text-wrap: balance;">
                  {data.title}
                  <span class="arrow text-sm text-on-surface-variant self-center transition-transform group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-primary">↗</span>
                </h2>
                <p class="desc text-on-surface-variant m-0 text-[15px] leading-[1.5] max-w-[52ch]" style="text-wrap: pretty;">
                  {data.tagline}
                </p>
                <div class="meta-row mt-auto flex items-center justify-between pt-3.5 border-t border-dashed border-outline-variant/40 text-[10px] font-medium uppercase tracking-[0.1em] text-on-surface-variant gap-3 flex-wrap">
                  <div class="flex flex-wrap gap-1.5">
                    {(data.tags ?? []).map(t => (
                      <span class="px-1.5 py-0.5 border border-outline-variant/40 rounded-sm text-on-surface-variant">{t}</span>
                    ))}
                  </div>
                  <div class="flex gap-3.5 items-center whitespace-nowrap">
                    <span>Live</span>
                    <span>{data.year}</span>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('#chips .chip');
  const cards = document.querySelectorAll<HTMLElement>('#grid [data-tags]');

  function setActive(active: HTMLButtonElement) {
    chips.forEach(c => {
      const isActive = c === active;
      c.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      c.classList.toggle('bg-on-surface', isActive);
      c.classList.toggle('text-surface', isActive);
      c.classList.toggle('border-on-surface', isActive);
    });
  }

  // initialize "All" as visually active
  const initial = document.querySelector<HTMLButtonElement>('#chips .chip[data-tag="All"]');
  if (initial) setActive(initial);

  const toggle = document.querySelector<HTMLButtonElement>('#filter-toggle');
  const chipList = document.querySelector<HTMLElement>('#chips');
  const label = document.querySelector<HTMLElement>('#filter-label');
  const count = document.querySelector<HTMLElement>('#filter-count');

  function setOpen(open: boolean) {
    if (!toggle || !chipList) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    chipList.classList.toggle('hidden', !open);
    chipList.classList.toggle('flex', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') setOpen(false);
  });

  chips.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? 'All';
      setActive(btn);
      // mirror the selection on the mobile toggle and collapse the panel
      if (label) label.textContent = tag;
      if (count) count.textContent = btn.querySelector('span')?.textContent ?? '';
      const filtered = tag !== 'All';
      toggle?.classList.toggle('bg-on-surface', filtered);
      toggle?.classList.toggle('text-surface', filtered);
      toggle?.classList.toggle('border-on-surface', filtered);
      setOpen(false);
      cards.forEach(card => {
        const cardTags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const visible = tag === 'All' || cardTags.includes(tag);
        card.style.display = visible ? '' : 'none';
      });
    });
  });
</script>

<style>
  .card {
    transition: transform .45s cubic-bezier(.2,.7,.2,1), border-color .25s, box-shadow .35s;
  }
</style>
