---
import BaseLayout from '../layouts/BaseLayout.astro';
import CloudinaryImage from '../components/CloudinaryImage.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diogo Adão e Silva',
  url: new URL('/', Astro.site).href,
  jobTitle: 'Product Manager',
  email: 'mailto:diogofcruz@gmail.com',
  sameAs: [
    'https://github.com/DiogoAdaoeSilva',
    'https://www.linkedin.com/in/diogoadaoesilva/',
  ],
};
---

<BaseLayout
  title="About"
  description="Meet Diogo Adão e Silva, a Milan-based Product Manager focused on AI-native workflows, operational systems, automation, and ecommerce technology."
  structuredData={personSchema}
>
  <main class="pt-28 pb-0">

    <!-- Page header -->
    <section class="px-6 md:px-14 pt-4 md:pt-6 pb-14 border-b border-outline-variant/30">
      <div class="max-w-[1400px] mx-auto">
        <div class="eyebrow flex items-center gap-3 text-[11px] tracking-[0.18em] uppercase text-on-surface-variant font-medium mb-7">
          <span class="h-px w-8 bg-current opacity-50"></span>
          <span>Diogo Adão e Silva · About</span>
        </div>

        <h1 class="font-bold tracking-tighter leading-[0.9] text-on-surface flex items-baseline flex-wrap gap-x-[0.2em]"
            style="font-size: clamp(3.5rem, 10vw, 7rem); margin-left: -0.06em;">
          <span>About</span>
        </h1>

    
      </div>
    </section>

    <!-- Portrait + bio -->
    <section class="px-6 md:px-14 py-20 md:py-24 border-b border-outline-variant/30">
      <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20 items-start">

        <!-- Portrait column -->
        <aside class="md:col-span-5 md:sticky md:top-28">
          <CloudinaryImage
            publicId="PA060015_fnuevc"
            alt="Diogo Adão e Silva"
            width={900}
            class="aspect-[4/5] w-full object-cover"
          />
        </aside>

        <!-- Bio column -->
        <div class="md:col-span-7 flex flex-col gap-14">

          <article>
           
            <h2 class="font-bold tracking-tighter leading-[1.02] text-on-surface text-3xl md:text-5xl mb-6 max-w-[18ch]" style="text-wrap: balance;">
              Excited about the<span class="text-primary italic"> future</span>.
            </h2>
            <div class="flex flex-col gap-4 text-on-surface-variant text-lg leading-relaxed max-w-[60ch]" style="text-wrap: pretty;">
              <p>I’m a product manager based in Milan, focused on operational systems, automation, and AI-native workflows.</p>
              <p>Most recently, I was <span class="text-on-surface font-medium">Head of Product at Westwing</span>, leading the teams responsible for the technology behind Finance and Operations across Westwing’s B2C, B2B, and offline retail businesses.</p>
              <p>As part of the tech management team, I helped drive a <span class="text-on-surface font-medium">complete rebuild of Westwing’s ecommerce stack</span> within a year — moving from a homegrown platform to a modern architecture built around Shopify, Algolia, and Salsify.</p>
              <p>This site is a collection of product experiments built with AI, inspired by problems I encountered at work and ideas I keep returning to: operational leverage, automation, knowledge systems, and human + AI collaboration.</p>
              <p>Outside work, I spend winters snowboarding in the <span class="text-on-surface font-medium">Alps</span> and summers in the <span class="text-on-surface font-medium">south of Portugal</span>.</p>
            </div>
          </article>
      

        </div>
      </div>
    </section>

    <!-- Contact -->
    <section class="px-6 md:px-14 py-24 md:py-28 text-center">
      <div class="max-w-[1400px] mx-auto">
        <div class="text-[11px] tracking-[0.18em] uppercase text-on-surface-variant font-medium mb-6">
          <span class="text-primary"></span>Reach out
        </div>
        <h3 class="font-bold tracking-tighter leading-[0.95] text-on-surface mb-10" style="font-size: clamp(2.5rem, 8vw, 6rem); text-wrap: balance;">
          Say <span class="text-primary italic">hi</span>.
        </h3>
        <div class="inline-flex flex-wrap gap-3 justify-center">
          <a
            href="mailto:diogofcruz@gmail.com"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-on-surface text-surface border border-on-surface text-[11px] tracking-[0.1em] uppercase font-medium hover:bg-primary hover:border-primary transition-colors"
          >
            diogofcruz@gmail.com <span class="opacity-80">↗</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
