---
/**
 * SavingsViz — ambient cover for the Savings Atlas project.
 * A single looping narrative in three scenes that mirrors what the app does:
 *   1. SCAN    — the provider logos rush past, accelerating into a blur
 *                ("scanning the savings landscape").
 *   2. PRODUCTS — the blur resolves into the product types the app catalogs
 *                (remunerated account, MMF, interest wallet, term deposit).
 *   3. COMPARE  — it settles on a side-by-side comparison, the app's core view.
 * Pure HTML + CSS so it fills any card aspect ratio without cropping.
 * Logos live in /public/logos/savings-atlas. ~13s loop.
 */

const logos = ['revolut', 'ramp', 'qonto', 'wise', 'bunq', 'airwallex'];
// repeat so the scrolling track stays full as it translates across
const track = [...logos, ...logos, ...logos];

const products = ['Remunerated account', 'Money market fund', 'Interest wallet', 'Term deposit'];

const DURATION = 13; // seconds, whole loop
---

<div class="savings-viz" style={`--dur:${DURATION}s`}>
  <!-- SCENE 1 — scan the landscape -->
  <div class="scene scan">
    <div class="scan-track">
      {track.map((id) => (
        <span class="logo-chip">
          <img src={`/logos/savings-atlas/${id}.png`} alt="" width="40" height="40" loading="lazy" />
        </span>
      ))}
    </div>
    <p class="caption">Scanning the landscape</p>
  </div>

  <!-- SCENE 2 — find the products -->
  <div class="scene products">
    <div class="pills">
      {products.map((p, i) => (
        <span class="pill" style={`--d:${0.12 * i}s`}>{p}</span>
      ))}
    </div>
    <p class="caption">Finding the products</p>
  </div>

  <!-- SCENE 3 — compare side by side -->
  <div class="scene compare">
    <div class="cmp">
      <div class="col left">
        <span class="name">Qonto</span>
        <span class="kind">Remunerated account</span>
        <span class="rate">up to 4%</span>
      </div>
      <div class="divider"></div>
      <div class="col right">
        <span class="name">Finom</span>
        <span class="kind">Money market fund</span>
        <span class="rate">5% promo</span>
      </div>
    </div>
    <p class="caption">Side by side</p>
  </div>
</div>

<style>
  .savings-viz {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    overflow: hidden;
    background: linear-gradient(135deg, #f2f4f2 0%, #e5e9e6 100%);
    font-family: 'Inter', system-ui, sans-serif;
    color: #2d3432;
  }

  /* every scene stacks and cross-fades on the shared timeline */
  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.8rem, 3cqw, 1.6rem);
    padding: clamp(1rem, 4cqw, 2.2rem);
    opacity: 0;
    will-change: opacity;
  }

  .caption {
    position: absolute;
    left: clamp(1rem, 4cqw, 2.2rem);
    bottom: clamp(0.9rem, 3.5cqw, 1.9rem);
    margin: 0;
    font-size: clamp(0.6rem, 1.6cqw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #595f66;
  }

  /* ---------- SCENE 1: scan ---------- */
  .scan { animation: scan-fade var(--dur) ease-in-out infinite; }
  .scan-track {
    display: flex;
    gap: clamp(0.5rem, 2cqw, 1rem);
    align-items: center;
    animation: scan-move var(--dur) cubic-bezier(0.6, 0, 0.9, 1) infinite;
    will-change: transform, filter;
  }
  .logo-chip {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: clamp(2.6rem, 10cqw, 4rem);
    aspect-ratio: 1;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid #adb3b0;
  }
  .logo-chip img { width: 66%; height: 66%; object-fit: contain; }

  @keyframes scan-fade {
    0%   { opacity: 1; }
    28%  { opacity: 1; }
    33%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes scan-move {
    0%   { transform: translateX(0);      filter: blur(0); }
    16%  { transform: translateX(-10%);   filter: blur(0); }
    26%  { transform: translateX(-95%);   filter: blur(4px); }
    32%  { transform: translateX(-165%);  filter: blur(10px); }
    100% { transform: translateX(-165%);  filter: blur(10px); }
  }

  /* ---------- SCENE 2: products ---------- */
  .products { animation: products-fade var(--dur) ease-in-out infinite; }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.45rem, 1.8cqw, 0.85rem);
    justify-content: center;
    max-width: 92%;
  }
  .pill {
    padding: clamp(0.35rem, 1.4cqw, 0.6rem) clamp(0.7rem, 2.6cqw, 1.1rem);
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid #adb3b0;
    font-size: clamp(0.68rem, 2cqw, 0.98rem);
    font-weight: 600;
    color: #2d3432;
    white-space: nowrap;
    animation: pill-rise var(--dur) ease-out infinite;
    animation-delay: var(--d);
    will-change: transform, opacity;
  }

  @keyframes products-fade {
    0%   { opacity: 0; }
    30%  { opacity: 0; }
    37%  { opacity: 1; }
    60%  { opacity: 1; }
    66%  { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes pill-rise {
    0%, 32% { opacity: 0; transform: translateY(10px); }
    40%     { opacity: 1; transform: translateY(0); }
    100%    { opacity: 1; transform: translateY(0); }
  }

  /* ---------- SCENE 3: compare ---------- */
  .compare { animation: compare-fade var(--dur) ease-in-out infinite; }
  .cmp {
    display: flex;
    align-items: stretch;
    width: min(92%, 30rem);
    background: #ffffff;
    border: 1px solid #adb3b0;
    border-radius: 12px;
    overflow: hidden;
  }
  .col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(0.2rem, 0.8cqw, 0.4rem);
    padding: clamp(0.7rem, 3cqw, 1.3rem);
    animation: col-in var(--dur) ease-out infinite;
    will-change: transform, opacity;
  }
  .col.left  { transform-origin: left; }
  .col.right { animation-delay: 0.18s; }
  .divider { width: 1px; background: #d8dcd9; }
  .name {
    font-size: clamp(0.85rem, 2.8cqw, 1.3rem);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .kind {
    font-size: clamp(0.58rem, 1.6cqw, 0.78rem);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #767c79;
  }
  .rate {
    margin-top: clamp(0.15rem, 0.8cqw, 0.4rem);
    font-size: clamp(0.78rem, 2.4cqw, 1.15rem);
    font-weight: 700;
    color: #2d3432;
    font-variant-numeric: tabular-nums;
  }

  @keyframes compare-fade {
    0%   { opacity: 0; }
    64%  { opacity: 0; }
    71%  { opacity: 1; }
    97%  { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes col-in {
    0%, 64% { opacity: 0; transform: translateY(8px); }
    73%     { opacity: 1; transform: translateY(0); }
    100%    { opacity: 1; transform: translateY(0); }
  }

  /* ---------- accessibility ---------- */
  @media (prefers-reduced-motion: reduce) {
    .scene { animation: none; }
    .scan, .products { opacity: 0; }
    .compare { opacity: 1; }
    .scan-track, .pill, .col { animation: none; opacity: 1; transform: none; filter: none; }
  }
</style>
